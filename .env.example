# AURA 2026 local configuration. Keep values blank in this template.
AURA_USERNAME=
AURA_ASSISTANT_NAME=
AURA_INPUT_LANGUAGE=
AURA_ASSISTANT_VOICE=

# Provider routing: auto, groq, cohere, or local
LLM_PROVIDER=
LLM_MODEL=
REASONING_PROVIDER=
VISION_PROVIDER=
GROQ_API_KEY=
COHERE_API_KEY=
STABILITY_API_KEY=

# Authentication and local encrypted persistence
JWT_SECRET=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
AURA_DATA_ENCRYPTION_KEY=
AURA_DATA_DIR=
AURA_RUNTIME_DIR=
AURA_DATABASE_PATH=
AURA_ALLOWED_FILE_ROOTS=
AURA_ALLOW_PLAINTEXT_DEV_STORAGE=
AURA_ENABLE_LEGACY_CHAT_LOG=
AURA_PRIVACY_MODE=

# Bounded agent limits
AURA_MAX_TOOL_CALLS=
AURA_MAX_RETRIES=
AURA_MAX_PLANNING_ITERATIONS=
AURA_TOOL_TIMEOUT_SECONDS=

# Razorpay TEST mode by default. LIVE requires exact acknowledgement.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=
RAZORPAY_LIVE_ACKNOWLEDGEMENT=
PAYMENT_LOCK=
PAYMENT_CONFIRMATION_SECONDS=
